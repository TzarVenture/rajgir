# Rajgir Marathon Digital Platform - Environment Template
# Copy this file to .env.local (for local dev) or .env.production (on VPS)

# Contact Form & Public Email
NEXT_PUBLIC_CONTACT_RECIPIENT_EMAIL=rajgirmarathon@gmail.com

# Google Apps Script Webhook URL for Live Google Sheet sync
NEXT_PUBLIC_GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Coming Soon & Preview Gating
# Set COMING_SOON=true during pre-launch (public sees Coming Soon; unauthorized routes redirect to /)
# Set COMING_SOON=false on official launch day (real site is served everywhere)
COMING_SOON=true

# Secret password for stakeholder / developer preview access
# 1) Accessible via password screen: /preview
# 2) Accessible via 1-click direct link: https://yourdomain.com/?preview_key=YOUR_PASSWORD
PREVIEW_PASSWORD=your_secure_preview_password_here

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# PostgreSQL Connection Strings (Prisma / Database)
# Note: If password contains special characters like # or @, URL-encode them (# -> %23, @ -> %40)
DATABASE_URL="postgresql://postgres.your-project-id:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-project-id:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"
