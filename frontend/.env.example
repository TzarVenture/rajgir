# Rajgir Marathon Digital Platform - Environment Template
# Copy this file to .env.local (for local dev) or .env.production (on VPS)

# Contact Form & Public Email
NEXT_PUBLIC_CONTACT_RECIPIENT_EMAIL=rajgirmarathon@gmail.com

# Google Apps Script Webhook URL for Live Google Sheet sync
NEXT_PUBLIC_GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Coming Soon & Preview Gating
# Set COMING_SOON=true during pre-launch (public sees Coming Soon; unauthorized routes redirect to /)
# Set COMING_SOON=false on official launch day (real site is served everywhere)
COMING_SOON=true

# Secret password for stakeholder / developer preview access
# 1) Accessible via password screen: /preview
# 2) Accessible via 1-click direct link: https://yourdomain.com/?preview_key=YOUR_PASSWORD
PREVIEW_PASSWORD=your_secure_preview_password_here

# Signing secret for the preview cookie (optional; defaults to PREVIEW_PASSWORD).
# Changing it logs everyone out of preview.
# NOTE: If PREVIEW_PASSWORD is empty, preview access is disabled (there is no default password).
# NOTE: The gate fails closed: anything other than COMING_SOON=false keeps the site gated.
PREVIEW_COOKIE_SECRET=change_me_to_a_long_random_string

# NestJS API used by the Next.js server for all backend operations (login, registrations).
# Production (Dokploy): internal address of the backend service, e.g. http://rajgir-backend:4000/api/v1
API_URL=http://127.0.0.1:4000/api/v1

# Participant dashboards (runner / volunteer)
# Race control desk number shown on the volunteer SOS panel (leave empty until issued; 112 and 108 are always shown).
NEXT_PUBLIC_RACE_CONTROL_PHONE=
# Registration receipts become GST tax invoices only when the organizer's GSTIN is set.
NEXT_PUBLIC_ORGANIZER_GSTIN=
NEXT_PUBLIC_ORGANIZER_LEGAL_NAME=Rajgir Marathon Organizing Committee
# SAC code printed on the invoice (confirm with your CA).
NEXT_PUBLIC_REGISTRATION_SAC_CODE=

# Shared secret with the NestJS API (same value as backend INTERNAL_API_SECRET). Server-only:
# never prefix with NEXT_PUBLIC_. Enables per-visitor rate limiting. Generate: openssl rand -hex 32
INTERNAL_API_SECRET=

# The session cookie is Secure (HTTPS-only) whenever NODE_ENV=production. Browsers accept that on
# http://localhost. Set COOKIE_SECURE=false ONLY to run a production build over plain http on
# another host (e.g. a LAN IP). Never set it to false on the public site.
# COOKIE_SECURE=false

# Visitor IP for rate limits. Default: the last X-Forwarded-For hop (appended by Traefik). Behind a
# proxy that sets its own always-overwritten header (e.g. Cloudflare), name it here: cf-connecting-ip
# CLIENT_IP_HEADER=
