# Server Configuration
PORT=4000
NODE_ENV=development

# Database (Supabase PostgreSQL)
# Transaction pooler for application queries:
DATABASE_URL="postgresql://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection for Prisma migrations:
DIRECT_URL="postgresql://postgres.xxx:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# Supabase Auth & Storage
SUPABASE_URL="https://xxx.supabase.co"
SUPABASE_ANON_KEY="eyJhbG..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbG..."
SUPABASE_JWT_SECRET="your_supabase_jwt_secret"

# CORS Allowed Origins (Comma-separated)
CORS_ORIGIN="http://localhost:3000,https://rajgirmarathon.com,https://www.rajgirmarathon.com"


# Public site URL (used in email links). Production: https://rajgirmarathon.com
FRONTEND_URL="http://localhost:3000"

# Email verification is required by default. Set to false to skip it for now
# (ALSO turn off "Confirm email" in Supabase: Authentication > Providers > Email).
REQUIRE_EMAIL_VERIFICATION="true"

# Race day (IST, YYYY-MM-DD). Used for age-on-race-day and volunteer check-in window.
# Keep in sync with frontend/src/lib/event.ts (EVENT.raceDate).
RACE_DATE="2027-11-21"
# Volunteer shift check-in is open from 3 days before race day to the day after. Set true to test it any time.
VOLUNTEER_CHECKIN_ALWAYS_OPEN="false"

# --- Authentication hardening ---
# Shared secret between the Next.js server and this API (same value in frontend/.env). Lets the
# frontend vouch for the visitor's IP so rate limits (e.g. 10 logins/min) apply per visitor rather
# than to everyone behind the Next.js server. Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=""
# Which proxies may set X-Forwarded-For. Default (unset) trusts only private-network peers
# (Docker / Traefik), so a client reaching the API directly cannot forge its IP.
# Accepts a hop count, a comma-separated list of IPs/subnets, "true" (avoid) or "false".
TRUST_PROXY=""
