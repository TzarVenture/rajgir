datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  RUNNER
  VOLUNTEER
  INFLUENCER
  TEAM_CAPTAIN
  CORPORATE_MANAGER
  SCHOOL_COORDINATOR
  SPONSOR
  VENDOR
  TOURISM_PARTNER
  ORGANIZER
  SUPER_ADMIN
}

enum AccountStatus {
  PENDING_ONBOARDING
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
}

model User {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email          String         @unique @db.VarChar(128)
  phone          String?        @unique @db.VarChar(20)
  fullName       String         @map("full_name") @db.VarChar(128)
  role           Role?
  status         AccountStatus  @default(PENDING_ONBOARDING)
  supabaseAuthId String?        @unique @map("supabase_auth_id") @db.VarChar(64)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // 1-to-1 Role Profile Relationships (Strict 1 User = 1 Role)
  runnerRegistration RunnerRegistration?
  volunteer          Volunteer?
  influencer         Influencer?
  teamProfile        TeamProfile?
  corporateProfile   CorporateProfile?
  schoolProfile      SchoolProfile?
  sponsorProfile     SponsorProfile?
  vendorProfile      VendorProfile?
  tourismProfile     TourismProfile?

  @@index([email])
  @@index([phone])
  @@map("users")
}

model RunnerRegistration {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String?  @unique @map("user_id") @db.Uuid
  user               User?    @relation(fields: [userId], references: [id])

  registrationNumber String   @unique @map("registration_number") @db.VarChar(32)
  
  // Race Info
  distance           String   @db.VarChar(16)
  raceTitle          String   @map("race_title") @db.VarChar(64)
  baseFee            Int      @map("base_fee")
  
  // Personal Info
  firstName          String   @map("first_name") @db.VarChar(64)
  lastName           String   @map("last_name") @db.VarChar(64)
  email              String   @db.VarChar(128)
  phone              String   @db.VarChar(15)
  dateOfBirth        DateTime @map("date_of_birth") @db.Date
  ageOnRaceDay       Int      @map("age_on_race_day")
  gender             String   @db.VarChar(16)
  
  // Bib & T-Shirt
  bibName            String   @map("bib_name") @db.VarChar(20)
  bloodGroup         String   @map("blood_group") @db.VarChar(8)
  tshirtSize         String   @map("tshirt_size") @db.VarChar(8)
  
  // Emergency & Medical
  emergencyName      String   @map("emergency_name") @db.VarChar(64)
  emergencyRelation  String   @map("emergency_relation") @db.VarChar(32)
  emergencyPhone     String   @map("emergency_phone") @db.VarChar(15)
  medicalNotes       String?  @map("medical_notes")
  
  // Address & Logistics
  city               String   @db.VarChar(64)
  state              String   @db.VarChar(64)
  pincode            String   @db.VarChar(10)
  country            String?  @default("India") @db.VarChar(32)
  runningClub        String?  @map("running_club") @db.VarChar(64)
  
  // Addons & Financials
  selectedAddons     Json?    @default("[]") @map("selected_addons")
  grossAmount        Int      @map("gross_amount")
  discountAmount     Int?     @default(0) @map("discount_amount")
  netAmount          Int      @map("net_amount")
  couponCode         String?  @map("coupon_code") @db.VarChar(32)
  
  // Lifecycle
  paymentStatus      String?  @default("CONFIRMED") @map("payment_status") @db.VarChar(24)
  qrCodeToken        String?  @default(dbgenerated("gen_random_uuid()")) @map("qr_code_token") @db.Uuid
  waiverAgreed       Boolean  @default(true) @map("waiver_agreed")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([email])
  @@index([phone])
  @@index([registrationNumber])
  @@index([distance])
  @@map("runner_registrations")
}

model Volunteer {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String?  @unique @map("user_id") @db.Uuid
  user                  User?    @relation(fields: [userId], references: [id])

  fullName              String   @map("full_name") @db.VarChar(128)
  email                 String   @db.VarChar(128)
  phone                 String   @db.VarChar(20)
  tShirtSize            String   @map("tshirt_size") @db.VarChar(10)
  emergencyContactName  String   @map("emergency_contact_name") @db.VarChar(128)
  emergencyContactPhone String   @map("emergency_contact_phone") @db.VarChar(20)
  availability          Json?    @default("[]")
  rolePreference        String   @map("role_preference") @db.VarChar(64)
  languagesSpoken       String?  @map("languages_spoken") @db.VarChar(128)
  dietaryRestrictions  String?  @map("dietary_restrictions") @db.VarChar(128)
  medicalCertification Boolean? @default(false) @map("medical_certification")
  waiverAgreed          Boolean  @default(true) @map("waiver_agreed")
  status                String?  @default("pending") @db.VarChar(24)
  submittedAt           DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  @@index([email])
  @@map("volunteers")
}

model Influencer {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                    String?  @unique @map("user_id") @db.Uuid
  user                      User?    @relation(fields: [userId], references: [id])

  fullName                  String   @map("full_name") @db.VarChar(128)
  stageName                 String?  @map("stage_name") @db.VarChar(128)
  email                     String   @db.VarChar(128)
  phone                     String   @db.VarChar(20)
  city                      String?  @db.VarChar(64)
  country                   String?  @default("India") @db.VarChar(64)
  primaryPlatform           String   @map("primary_platform") @db.VarChar(32)
  profileUrl                String   @map("profile_url") @db.VarChar(255)
  followerCount             String   @map("follower_count") @db.VarChar(32)
  engagementRate            String?  @map("engagement_rate") @db.VarChar(32)
  targetNiche               String   @map("target_niche") @db.VarChar(64)
  collaborationDeliverables String   @map("collaboration_deliverables") @db.Text
  status                    String?  @default("pending") @db.VarChar(24)
  submittedAt               DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  @@index([email])
  @@map("influencers")
}

// ==========================================
// GROUP TRACK MODELS
// ==========================================

model TeamProfile {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  teamName        String   @map("team_name") @db.VarChar(128)
  clubAffiliation String?  @map("club_affiliation") @db.VarChar(128)
  city            String   @db.VarChar(64)
  teamJoinCode    String   @unique @map("team_join_code") @db.VarChar(16)
  estimatedMembers Int     @default(5) @map("estimated_members")
  notes           String?  @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("team_profiles")
}

model CorporateProfile {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName         String   @map("company_name") @db.VarChar(128)
  gstin               String?  @db.VarChar(32)
  officialEmailDomain String   @map("official_email_domain") @db.VarChar(64)
  designation         String   @db.VarChar(64)
  estimatedPasses     Int      @map("estimated_passes")
  csrFocus            String?  @map("csr_focus") @db.VarChar(128)
  billingAddress      String?  @map("billing_address") @db.Text
  status              String   @default("pending") @db.VarChar(24) // pending, approved, rejected
  submittedAt         DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  @@map("corporate_profiles")
}

model SchoolProfile {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  schoolName          String   @map("school_name") @db.VarChar(128)
  boardAffiliation    String   @map("board_affiliation") @db.VarChar(64) // CBSE, ICSE, Bihar Board, State Board
  city                String   @db.VarChar(64)
  teacherInCharge     String   @map("teacher_in_charge") @db.VarChar(128)
  teacherDesignation  String   @map("teacher_designation") @db.VarChar(64)
  estimatedStudents   Int      @map("estimated_students")
  parentalConsentAgreed Boolean @default(true) @map("parental_consent_agreed")
  status              String   @default("pending") @db.VarChar(24) // pending, approved, rejected
  submittedAt         DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  @@map("school_profiles")
}

// ==========================================
// PARTNER TRACK MODELS
// ==========================================

model SponsorProfile {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  brandName           String   @map("brand_name") @db.VarChar(128)
  industry            String   @db.VarChar(64)
  tierInterest        String   @map("tier_interest") @db.VarChar(64) // Title, Powered By, Hydration, Recovery, Tech
  budgetBand          String   @map("budget_band") @db.VarChar(32)
  brandWebsite        String?  @map("brand_website") @db.VarChar(255)
  proposalDeliverables String? @map("proposal_deliverables") @db.Text
  status              String   @default("pending") @db.VarChar(24) // pending, discussion, approved
  submittedAt         DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  @@map("sponsor_profiles")
}

model VendorProfile {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName        String   @map("business_name") @db.VarChar(128)
  stallCategory       String   @map("stall_category") @db.VarChar(64) // Food & Refreshments, Running Gear, Nutrition & Supplements, Bihar Handicrafts
  stallSize           String   @map("stall_size") @db.VarChar(32) // Standard (3x3m), Premium (6x3m)
  fssaiNumber         String?  @map("fssai_number") @db.VarChar(32)
  electricPowerRequired Boolean @default(false) @map("electric_power_required")
  status              String   @default("pending") @db.VarChar(24) // pending, approved, stall_allocated
  submittedAt         DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  @@map("vendor_profiles")
}

model TourismProfile {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName        String   @map("business_name") @db.VarChar(128)
  serviceType         String   @map("service_type") @db.VarChar(64) // Hotel / Resort, Cab / Shuttle Fleet, Guided Heritage Tours
  location            String   @db.VarChar(128)
  distanceFromStartLine String? @map("distance_from_start_line") @db.VarChar(32)
  inventoryCapacity   String   @map("inventory_capacity") @db.VarChar(64)
  discountOffering    String?  @map("discount_offering") @db.VarChar(128)
  status              String   @default("pending") @db.VarChar(24) // pending, approved, active_listing
  submittedAt         DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  @@map("tourism_profiles")
}
