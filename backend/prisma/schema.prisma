datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  RUNNER
  VOLUNTEER
  INFLUENCER
  TEAM_CAPTAIN
  CORPORATE_MANAGER
  SCHOOL_COORDINATOR
  SPONSOR
  VENDOR
  TOURISM_PARTNER
  ORGANIZER
  SUPER_ADMIN
}

enum AccountStatus {
  PENDING_ONBOARDING
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
}

enum RegistrationSource {
  SELF_REGISTERED
  SCHOOL_REGISTERED
  CORPORATE_REGISTERED
  TEAM_REGISTERED
}

enum QuotaAppealStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Identity lives only here (single source of truth). Role tables hold domain data and link by user_id.
  firstName          String             @map("first_name") @db.VarChar(64)
  lastName           String             @map("last_name") @db.VarChar(64)
  /// Lowercase; unique. Nullable only for managed participants (e.g. minor school students).
  email              String?            @unique @db.VarChar(128)
  /// Normalised 10-digit mobile; unique. Nullable for legacy rows or managed minors.
  phone              String?            @unique @db.VarChar(20)
  role               Role?
  status             AccountStatus      @default(PENDING_ONBOARDING)
  supabaseAuthId     String?            @unique @map("supabase_auth_id") @db.VarChar(64)
  registrationSource RegistrationSource @default(SELF_REGISTERED) @map("registration_source")
  registeredByUserId String?            @map("registered_by_user_id") @db.Uuid
  registeredBy       User?              @relation("ManagedRegistrations", fields: [registeredByUserId], references: [id], onDelete: SetNull)
  managedUsers       User[]             @relation("ManagedRegistrations")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // 1-to-1 Role Profile Relationships (Strict 1 User = 1 Role)
  runnerRegistration RunnerRegistration?
  volunteer          Volunteer?
  influencer         Influencer?
  teamProfile        TeamProfile?
  corporateProfile   CorporateProfile?
  schoolProfile      SchoolProfile?
  sponsorProfile     SponsorProfile?
  vendorProfile      VendorProfile?
  tourismProfile     TourismProfile?
  adminProfile       AdminProfile?
  superAdminProfile  SuperAdminProfile?
  createdAdmins      AdminProfile[]      @relation("AdminCreatedBy")

  @@index([email])
  @@index([phone])
  @@index([registeredByUserId])
  @@map("users")
}

model RunnerRegistration {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String   @unique @map("user_id") @db.Uuid
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  registrationNumber String   @unique @map("registration_number") @db.VarChar(32)
  
  // Race Info
  distance           String   @db.VarChar(16)
  raceTitle          String   @map("race_title") @db.VarChar(64)
  baseFee            Int      @map("base_fee")
  
  // Participant details (name, email and mobile come from the linked User)
  dateOfBirth        DateTime @map("date_of_birth") @db.Date
  ageOnRaceDay       Int      @map("age_on_race_day")
  gender             String   @db.VarChar(16)
  
  // Bib & T-Shirt
  bibName            String   @map("bib_name") @db.VarChar(20)
  bloodGroup         String   @map("blood_group") @db.VarChar(8)
  tshirtSize         String   @map("tshirt_size") @db.VarChar(8)
  
  // Emergency & Medical
  emergencyName      String   @map("emergency_name") @db.VarChar(64)
  emergencyRelation  String   @map("emergency_relation") @db.VarChar(32)
  emergencyPhone     String   @map("emergency_phone") @db.VarChar(15)
  medicalNotes       String?  @map("medical_notes")
  
  // Address & Logistics
  city               String   @db.VarChar(64)
  state              String   @db.VarChar(64)
  pincode            String   @db.VarChar(10)
  country            String?  @default("India") @db.VarChar(32)
  runningClub        String?  @map("running_club") @db.VarChar(64)
  
  // Addons & Financials
  selectedAddons     Json?    @default("[]") @map("selected_addons")
  grossAmount        Int      @map("gross_amount")
  discountAmount     Int?     @default(0) @map("discount_amount")
  netAmount          Int      @map("net_amount")
  couponCode         String?  @map("coupon_code") @db.VarChar(32)
  
  // Lifecycle
  paymentStatus      String?  @default("CONFIRMED") @map("payment_status") @db.VarChar(24)
  qrCodeToken        String?  @default(dbgenerated("gen_random_uuid()")) @map("qr_code_token") @db.Uuid
  waiverAgreed       Boolean  @default(true) @map("waiver_agreed")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Race operations (set by organizers; null until allotted)
  /// Expected finish time "HH:MM" given at registration; used for target pace bands.
  estimatedFinishTime String?   @map("estimated_finish_time") @db.VarChar(8)
  /// Printed bib number, allotted by organizers after the registration cut-off.
  bibNumber           String?   @unique @map("bib_number") @db.VarChar(12)
  kitCollectedAt      DateTime? @map("kit_collected_at") @db.Timestamptz(6)
  /// Who collected the kit: "SELF" or the proxy's name.
  kitCollectedBy      String?   @map("kit_collected_by") @db.VarChar(64)
  medicalUpdatedAt    DateTime? @map("medical_updated_at") @db.Timestamptz(6)

  result              RaceResult?

  @@index([registrationNumber])
  @@index([distance])
  @@map("runner_registrations")
}

model Volunteer {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String   @unique @map("user_id") @db.Uuid
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  tShirtSize            String   @map("tshirt_size") @db.VarChar(10)
  emergencyContactName  String   @map("emergency_contact_name") @db.VarChar(128)
  emergencyContactPhone String   @map("emergency_contact_phone") @db.VarChar(20)
  availability          Json?    @default("[]")
  rolePreference        String   @map("role_preference") @db.VarChar(64)
  languagesSpoken       String?  @map("languages_spoken") @db.VarChar(128)
  dietaryRestrictions  String?  @map("dietary_restrictions") @db.VarChar(128)
  medicalCertification Boolean? @default(false) @map("medical_certification")
  waiverAgreed          Boolean  @default(true) @map("waiver_agreed")
  status                String?  @default("pending") @db.VarChar(24)
  submittedAt           DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  // Deployment (set by organizers; null until assigned)
  assignedRole          String?   @map("assigned_role") @db.VarChar(64)
  assignedStation       String?   @map("assigned_station") @db.VarChar(64)
  assignedSector        String?   @map("assigned_sector") @db.VarChar(32)
  supervisorName        String?   @map("supervisor_name") @db.VarChar(128)
  supervisorPhone       String?   @map("supervisor_phone") @db.VarChar(20)
  shiftStart            DateTime? @map("shift_start") @db.Timestamptz(6)
  shiftEnd              DateTime? @map("shift_end") @db.Timestamptz(6)
  /// OFF_DUTY | ON_DUTY | ON_BREAK
  dutyStatus            String    @default("OFF_DUTY") @map("duty_status") @db.VarChar(16)
  dutyStatusAt          DateTime? @map("duty_status_at") @db.Timestamptz(6)
  /// { [checklistItemId]: ISO timestamp when ticked }
  checklist             Json      @default("{}")

  attendance            VolunteerAttendance[]
  incidents             Incident[]

  @@index([assignedStation])
  @@map("volunteers")
}

/// One check-in / check-out pair for a volunteer shift.
model VolunteerAttendance {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  volunteerId  String    @map("volunteer_id") @db.Uuid
  volunteer    Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  checkInAt    DateTime  @default(now()) @map("check_in_at") @db.Timestamptz(6)
  checkOutAt   DateTime? @map("check_out_at") @db.Timestamptz(6)
  station      String?   @db.VarChar(64)
  latitude     Float?
  longitude    Float?

  @@index([volunteerId])
  @@map("volunteer_attendance")
}

/// Incidents and SOS alerts raised from the field for race control.
model Incident {
  id             String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId     String     @map("reporter_id") @db.Uuid
  volunteerId    String?    @map("volunteer_id") @db.Uuid
  volunteer      Volunteer? @relation(fields: [volunteerId], references: [id], onDelete: SetNull)
  /// MEDICAL | SECURITY | LOST_PERSON | COURSE_HAZARD | HYDRATION | CROWD | OTHER
  type           String     @db.VarChar(24)
  /// LOW | MEDIUM | HIGH | CRITICAL
  severity       String     @db.VarChar(12)
  isSos          Boolean    @default(false) @map("is_sos")
  location       String     @db.VarChar(128)
  latitude       Float?
  longitude      Float?
  runnerBib      String?    @map("runner_bib") @db.VarChar(16)
  description    String     @db.Text
  /// OPEN | ACKNOWLEDGED | RESOLVED
  status         String     @default("OPEN") @db.VarChar(16)
  acknowledgedAt DateTime?  @map("acknowledged_at") @db.Timestamptz(6)
  resolvedAt     DateTime?  @map("resolved_at") @db.Timestamptz(6)
  resolutionNote String?    @map("resolution_note") @db.Text
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([status])
  @@index([createdAt])
  @@index([volunteerId])
  @@map("incidents")
}

/// Official timing result for one runner, written by the timing partner import (staff only).
model RaceResult {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  registrationId String             @unique @map("registration_id") @db.Uuid
  registration   RunnerRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  /// FINISHED | DNF | DNS | DSQ
  status         String             @db.VarChar(12)
  gunTimeSeconds Int?               @map("gun_time_seconds")
  netTimeSeconds Int?               @map("net_time_seconds")
  overallRank    Int?               @map("overall_rank")
  genderRank     Int?               @map("gender_rank")
  categoryRank   Int?               @map("category_rank")
  ageCategory    String?            @map("age_category") @db.VarChar(24)
  /// [{ "label": "5K", "distanceKm": 5, "elapsedSeconds": 1520 }, ...] cumulative chip times
  splits         Json               @default("[]")
  publishedAt    DateTime           @default(now()) @map("published_at") @db.Timestamptz(6)

  @@map("race_results")
}

model Influencer {
  id                        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                    String   @unique @map("user_id") @db.Uuid
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  stageName                 String?  @map("stage_name") @db.VarChar(128)
  city                      String?  @db.VarChar(64)
  country                   String?  @default("India") @db.VarChar(64)
  primaryPlatform           String   @map("primary_platform") @db.VarChar(32)
  profileUrl                String   @map("profile_url") @db.VarChar(255)
  followerCount             String   @map("follower_count") @db.VarChar(32)
  engagementRate            String?  @map("engagement_rate") @db.VarChar(32)
  targetNiche               String   @map("target_niche") @db.VarChar(64)
  collaborationDeliverables String   @map("collaboration_deliverables") @db.Text
  status                    String?  @default("pending") @db.VarChar(24)
  submittedAt               DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  @@map("influencers")
}

// ==========================================
// GROUP TRACK MODELS
// ==========================================

model TeamProfile {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @unique @map("user_id") @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  teamName        String   @map("team_name") @db.VarChar(128)
  clubAffiliation String?  @map("club_affiliation") @db.VarChar(128)
  city            String   @db.VarChar(64)
  teamJoinCode    String   @unique @map("team_join_code") @db.VarChar(16)
  estimatedMembers     Int               @default(5) @map("estimated_members")
  maxRunnerQuota       Int               @default(50) @map("max_runner_quota")
  appealRequestedQuota Int?              @map("appeal_requested_quota")
  appealReason         String?           @map("appeal_reason") @db.Text
  appealStatus         QuotaAppealStatus @default(NONE) @map("appeal_status")
  appealSubmittedAt    DateTime?         @map("appeal_submitted_at") @db.Timestamptz(6)
  notes                String?           @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("team_profiles")
}

model CorporateProfile {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName         String   @map("company_name") @db.VarChar(128)
  gstin               String?  @db.VarChar(32)
  officialEmailDomain String   @map("official_email_domain") @db.VarChar(64)
  designation         String   @db.VarChar(64)
  estimatedPasses      Int               @map("estimated_passes")
  maxRunnerQuota       Int               @default(50) @map("max_runner_quota")
  appealRequestedQuota Int?              @map("appeal_requested_quota")
  appealReason         String?           @map("appeal_reason") @db.Text
  appealStatus         QuotaAppealStatus @default(NONE) @map("appeal_status")
  appealSubmittedAt    DateTime?         @map("appeal_submitted_at") @db.Timestamptz(6)
  csrFocus             String?           @map("csr_focus") @db.VarChar(128)
  billingAddress      String?  @map("billing_address") @db.Text
  status              String   @default("pending") @db.VarChar(24) // pending, approved, rejected
  submittedAt         DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  @@map("corporate_profiles")
}

model SchoolProfile {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  schoolName          String   @map("school_name") @db.VarChar(128)
  boardAffiliation    String   @map("board_affiliation") @db.VarChar(64) // CBSE, ICSE, Bihar Board, State Board
  city                String   @db.VarChar(64)
  teacherInCharge     String   @map("teacher_in_charge") @db.VarChar(128)
  teacherDesignation  String   @map("teacher_designation") @db.VarChar(64)
  estimatedStudents     Int               @map("estimated_students")
  maxRunnerQuota        Int               @default(50) @map("max_runner_quota")
  appealRequestedQuota  Int?              @map("appeal_requested_quota")
  appealReason          String?           @map("appeal_reason") @db.Text
  appealStatus          QuotaAppealStatus @default(NONE) @map("appeal_status")
  appealSubmittedAt     DateTime?         @map("appeal_submitted_at") @db.Timestamptz(6)
  parentalConsentAgreed Boolean           @default(true) @map("parental_consent_agreed")
  status              String   @default("pending") @db.VarChar(24) // pending, approved, rejected
  submittedAt         DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  @@map("school_profiles")
}

// ==========================================
// PARTNER TRACK MODELS
// ==========================================

model SponsorProfile {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  brandName           String   @map("brand_name") @db.VarChar(128)
  industry            String   @db.VarChar(64)
  tierInterest        String   @map("tier_interest") @db.VarChar(64) // Title, Powered By, Hydration, Recovery, Tech
  budgetBand          String   @map("budget_band") @db.VarChar(32)
  brandWebsite        String?  @map("brand_website") @db.VarChar(255)
  proposalDeliverables String? @map("proposal_deliverables") @db.Text
  status              String   @default("pending") @db.VarChar(24) // pending, discussion, approved
  submittedAt         DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  @@map("sponsor_profiles")
}

model VendorProfile {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName        String   @map("business_name") @db.VarChar(128)
  stallCategory       String   @map("stall_category") @db.VarChar(64) // Food & Refreshments, Running Gear, Nutrition & Supplements, Bihar Handicrafts
  stallSize           String   @map("stall_size") @db.VarChar(32) // Standard (3x3m), Premium (6x3m)
  fssaiNumber         String?  @map("fssai_number") @db.VarChar(32)
  electricPowerRequired Boolean @default(false) @map("electric_power_required")
  status              String   @default("pending") @db.VarChar(24) // pending, approved, stall_allocated
  submittedAt         DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  @@map("vendor_profiles")
}

model TourismProfile {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  businessName        String   @map("business_name") @db.VarChar(128)
  serviceType         String   @map("service_type") @db.VarChar(64) // Hotel / Resort, Cab / Shuttle Fleet, Guided Heritage Tours
  location            String   @db.VarChar(128)
  distanceFromStartLine String? @map("distance_from_start_line") @db.VarChar(32)
  inventoryCapacity   String   @map("inventory_capacity") @db.VarChar(64)
  discountOffering    String?  @map("discount_offering") @db.VarChar(128)
  status              String   @default("pending") @db.VarChar(24) // pending, approved, active_listing
  submittedAt         DateTime @default(now()) @map("submitted_at") @db.Timestamptz(6)

  @@map("tourism_profiles")
}

// ---------------------------------------------------------------------------
// 10. SUPER ADMINS & ADMINS (Event Command Center & Access Governance)
// ---------------------------------------------------------------------------

model SuperAdminProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  designation String   @default("Event Director") @db.VarChar(120)
  isRoot      Boolean  @default(true) @map("is_root")
  isActive    Boolean  @default(true) @map("is_active")
  notes       String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("super_admins")
}

model AdminProfile {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  designation         String   @default("Operations Admin") @db.VarChar(120)
  department          String?  @db.VarChar(80)
  isActive            Boolean  @default(true) @map("is_active")
  canManageRunners    Boolean  @default(true) @map("can_manage_runners")
  canAllotBibs        Boolean  @default(true) @map("can_allot_bibs")
  canManageVolunteers Boolean  @default(true) @map("can_manage_volunteers")
  canManageInfluencers Boolean @default(true) @map("can_manage_influencers")
  canManageGroups     Boolean  @default(true) @map("can_manage_groups")
  canManagePartners   Boolean  @default(true) @map("can_manage_partners")
  canManageIncidents  Boolean  @default(true) @map("can_manage_incidents")
  assignedByUserId    String?  @map("assigned_by_user_id") @db.Uuid
  assignedBy          User?    @relation("AdminCreatedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  notes               String?  @db.VarChar(500)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([assignedByUserId])
  @@map("admins")
}
